APP_NAME=CampusConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ubuntu-vm.tailbc85b1.ts.net:8443

# Origin van de frontend (alleen schema + domein, geen pad). Meerdere? Scheiden met een komma.
CORS_ALLOWED_ORIGINS=https://ubuntu-vm.tailbc85b1.ts.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL: vul alleen DB_USERNAME en DB_PASSWORD in
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campusconnect
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
